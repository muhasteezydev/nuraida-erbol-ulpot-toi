{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design tokens for Erbol & Nuraida monochrome editorial wedding invitation.",
  "color": {
    "primary": { "$value": "#111111", "$type": "color" },
    "on-primary": { "$value": "#F4F2EE", "$type": "color" },
    "secondary": { "$value": "#1A1A1A", "$type": "color" },
    "on-secondary": { "$value": "#F4F2EE", "$type": "color" },
    "accent": { "$value": "#0A0A0A", "$type": "color" },
    "on-accent": { "$value": "#F4F2EE", "$type": "color" },
    "background": { "$value": "#F4F2EE", "$type": "color" },
    "foreground": { "$value": "#111111", "$type": "color" },
    "card": { "$value": "#F4F2EE", "$type": "color" },
    "card-foreground": { "$value": "#111111", "$type": "color" },
    "muted": { "$value": "#E7E4DE", "$type": "color" },
    "muted-foreground": { "$value": "#52504C", "$type": "color" },
    "border": { "$value": "#111111", "$type": "color" },
    "border-subtle": { "$value": "#CFCBC4", "$type": "color" },
    "ring": { "$value": "#111111", "$type": "color" }
  },
  "font": {
    "display": { "$value": "\"Cormorant Garamond\", Georgia, serif", "$type": "fontFamily" },
